# Copy to .env.local and fill in. Never commit .env.local.

# Live mode needs one LLM key. Scripted and Replay modes work without any.
# Order: NEAR AI Cloud (https://cloud.near.ai) if its key is set, else DeepSeek, with automatic
# fallback to OpenAI if DeepSeek errors. NEAR AI never falls back to another provider.
NEARAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# KINWARDEN_PROVIDER=nearai       # nearai | deepseek | openai | anthropic
# ANTHROPIC_API_KEY=             # only if KINWARDEN_PROVIDER=anthropic

# Optional overrides
# KINWARDEN_MODEL=deepseek-v4-pro  # NEAR AI default: deepseek-ai/DeepSeek-V4.1-Flash-1017
# KINWARDEN_EFFORT=high          # DeepSeek: low | high | max (OpenAI uses its default with tools)
# KINWARDEN_FALLBACK=none        # don't switch to the other provider when the main one fails
# KINWARDEN_STEP_DELAY_MS=700    # pacing for Replay/Scripted steps (video-friendly)
# KINWARDEN_DATA_DIR=.data       # where the world, ledger and recordings are stored

# On-chain anchoring (optional; without it anchors stay local). Create the testnet-only key with:
#   node scripts/anchor-key.mjs        (writes these two lines into .env.local and prints only the address)
# ANCHOR_CHAIN=conflux-espace-testnet
# ANCHOR_PRIVATE_KEY=

# Public deployment: a private sandbox world per visitor (cookie), and Replay as the starting mode
# KINWARDEN_SESSIONS=per-visitor
# KINWARDEN_DEFAULT_MODE=replay        # live | replay | scripted for new worlds
# KINWARDEN_MAX_SESSIONS=80
# KINWARDEN_SESSION_IDLE_HOURS=6
# NEAR vault (optional; without it payments stay on simulated rails). scripts/near/setup.mjs (testnet) or
# scripts/near/sandbox.mjs (local node) writes this line and .near/deployment.json. It is a function-call
# key limited to the vault's propose_payment, sweep and anchor_log; the app checks that on chain and refuses
# anything broader. It is not a model key: NEARAI_API_KEY above has no NEAR account authority.
# NEAR_AGENT_KEY=
