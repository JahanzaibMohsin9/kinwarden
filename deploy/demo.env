# Public demo (K12): Replay by default, a private sandbox per visitor, and NEAR read-only.
# Deliberately holds NO secrets: no NEAR_AGENT_KEY, no NEARAI_API_KEY or other model key, no anchor key.
# The agent's PUBLIC key lets the attack lab read its permissions from testnet; nothing can be signed.
KINWARDEN_DEFAULT_MODE=replay
KINWARDEN_SESSIONS=per-visitor
KINWARDEN_MAX_SESSIONS=80
KINWARDEN_SESSION_IDLE_HOURS=6
NEAR_DEPLOYMENT_FILE=/app/deploy/near-testnet.json
NEAR_AGENT_PUBLIC_KEY=ed25519:3Png5oub7p5wnci1n15ZRGj4iHWm3dRn2HBH2nwj55BW
